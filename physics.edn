;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a job-site scheduling/logistics coordination robot
;; for concrete placers and finishers (ISCO 7114) logs work records, schedules
;; crews and pour timing, and coordinates supply orders; it never places or
;; finishes concrete itself. Its physical work is moving supplies across the
;; site, and the physics its pour-timing decision depends on is how fast a
;; freshly placed slab loses heat in cold weather.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-7114"
 :cases
 [{:id :supply-pallet-haul
   :kind :transport
   :procedure "site logistics robot hauls a pallet of cement bags / rebar bundles 80 m over compacted gravel from the laydown yard to the pour area"
   :params {:mass-kg 150.0 :distance-m 80.0 :v-max-mps 1.2 :a-max-mps2 0.5
            :brake-decel-mps2 0.8 :drive-force-n 450.0 :crr 0.05
            :cog-height-m 0.70 :support-half-length-m 0.45}
   :sweep {:param :payload-kg :values [50.0 100.0 200.0 300.0 500.0]}
   :quantity :cycle-time-s
   :limit {:max 120.0 :basis "estimate: one supply leg must fit inside a 2-minute slot of the pour-timing schedule so the crew is not kept waiting"}
   :boundary {:lo 10.0 :hi 1500.0}}
  {:id :fresh-slab-cold-protection
   :kind :thermal
   :procedure "freshly placed 200 mm slab-on-grade exposed to -10 C night air for 12 h; the upper face is covered by an insulating blanket whose film coefficient is swept"
   :params {:thickness-m 0.20 :conductivity-w-mk 1.8 :density-kg-m3 2400.0 :specific-heat-j-kgk 1000.0
            :t0-c 15.0 :t-hot-c -10.0 :t-back-ambient-c 5.0 :h-back-w-m2k 10.0
            :threshold-c 100.0 :duration-s 43200.0}
   :sweep {:param :h-front-w-m2k :values [0.5 1.0 2.0 5.0 10.0 25.0]}
   :quantity :mean-c
   :limit {:min 5.0 :basis "estimate: keep the section mean at least 5 C above freezing of the pore water during the first night of curing; hydration heat is not modelled, so the margin is conservative"}
   :boundary {:lo 0.5 :hi 50.0}}]}
